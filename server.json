{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jinsim/f1verse",
  "description": "Formula 1 race data with the domain rules applied: stints, tyre wear, publish-safety. Zero deps.",
  "version": "0.14.0",
  "websiteUrl": "https://jinsim.github.io/f1verse/",
  "repository": {
    "url": "https://github.com/jinsim/f1verse",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "f1verse",
      "version": "0.14.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "f1verse"
        },
        {
          "type": "positional",
          "valueHint": "command",
          "value": "f1verse-mcp"
        }
      ]
    }
  ]
}
